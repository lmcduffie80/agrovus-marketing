# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...           # Use sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...         # Stripe Dashboard → Webhooks → Signing secret

# ─── Base Plan Price IDs ───────────────────────────────────────────────────────
# Each plan needs 3 prices: monthly license, annual license, one-time impl fee

# Starter ($499/mo | $399/mo annual | $999 impl)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_ANNUAL_PRICE_ID=price_...
STRIPE_STARTER_IMPL_PRICE_ID=price_...

# Growth ($1,199/mo | $959/mo annual | $1,999 impl)
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
STRIPE_GROWTH_ANNUAL_PRICE_ID=price_...
STRIPE_GROWTH_IMPL_PRICE_ID=price_...

# Scale ($2,499/mo | $1,999/mo annual | $4,999 impl)
STRIPE_SCALE_MONTHLY_PRICE_ID=price_...
STRIPE_SCALE_ANNUAL_PRICE_ID=price_...
STRIPE_SCALE_IMPL_PRICE_ID=price_...

# ─── Module Add-On Price IDs ───────────────────────────────────────────────────
STRIPE_ADDON_DFII_PRICE_ID=price_...           # Material Requirements DFII  +$299/mo
STRIPE_ADDON_TOLL_PRICE_ID=price_...           # Toll Manufacturing Portal   +$199/mo
STRIPE_ADDON_CONSOLIDATION_PRICE_ID=price_...  # Advanced Financial Consol.  +$249/mo
STRIPE_ADDON_API_PRICE_ID=price_...            # API Access                  +$199/mo

# ─── Seat Pack Price IDs ───────────────────────────────────────────────────────
STRIPE_SEATS_5_PRICE_ID=price_...    # +5 users   +$99/mo
STRIPE_SEATS_10_PRICE_ID=price_...   # +10 users  +$179/mo
STRIPE_SEATS_UNL_PRICE_ID=price_...  # Unlimited  +$299/mo

# ─── Integration Price IDs ─────────────────────────────────────────────────────
STRIPE_INT_QBO_PRICE_ID=price_...    # QuickBooks Online      +$149/mo
STRIPE_INT_API_PRICE_ID=price_...    # API overage 100K calls  +$49/mo
STRIPE_INT_EDI_PRICE_ID=price_...    # EDI / Custom Export    +$299/mo

# ─── Support Tier Price IDs ────────────────────────────────────────────────────
STRIPE_SUPPORT_PRO_PRICE_ID=price_...  # Professional support  +$199/mo
STRIPE_SUPPORT_ENT_PRICE_ID=price_...  # Enterprise support    +$499/mo

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://agrovus-marketing.vercel.app

# ─── Database (Neon) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...   # Neon connection string

# ─── ERP Provisioning ──────────────────────────────────────────────────────
PROVISION_SECRET="# Strong random secret — must match PROVISION_SECRET on the ERP (agrovus.app). Never commit the real value."
ERP_PROVISION_URL="https://agrovus.app/api/provision"
