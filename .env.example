# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...           # Use sk_test_... for development
STRIPE_WEBHOOK_SECRET=whsec_...         # Stripe Dashboard → Webhooks → Signing secret

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://agrovus-marketing.vercel.app

# ─── Pre-launch site lock ───────────────────────────────────────────────────────
# When set, every page (except /coming-soon and /api routes) shows a "Coming
# Soon" placeholder to visitors. Unlock your own browser by visiting any URL
# once with ?key=<value> appended (sets a 30-day cookie). Leave unset to make
# the site fully public.
SITE_LOCK_PASSWORD=

# ─── Database (Neon) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://...   # Neon connection string

# ─── ERP Provisioning ──────────────────────────────────────────────────────────
# Shared secret — must match PROVISION_SECRET on the ERP (agrovus.app).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value.
PROVISION_SECRET=
ERP_PROVISION_URL=https://agrovus.app/api/provision

# ─── Commerce storefront proxy ──────────────────────────────────────────────────
# store.agrovus.com rewrites every request to this origin (the Agrovus-erp
# commerce module — see next.config.ts). Only needs overriding locally to
# point at a dev/preview deployment instead of production.
STORE_ORIGIN=https://agrovus.app
